# Copy this file to .env and fill in your keys

# Required — Gemini AI for job scoring and cover letter generation
# Get free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional — UK jobs from Reed.co.uk (highly recommended)
# Get free key at: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=your_reed_api_key_here

# Optional — Adzuna job board
# Get free key at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional — only needed for scripts/scheduled_search.py (GitHub Actions
# daily search -> Google Sheet). Not needed to run the Streamlit app itself.
# See README's "Scheduled Search Setup" section for how to obtain these.
GOOGLE_SHEETS_CREDENTIALS_JSON=your_service_account_json_here
GOOGLE_SHEET_ID=your_target_sheet_id_here
